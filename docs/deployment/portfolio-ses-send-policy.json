{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendPortfolioReviewNotifications",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ses:ap-southeast-3:314629419522:identity/doniputra.com",
        "arn:aws:ses:ap-southeast-3:314629419522:identity/doniputrapurbawa@gmail.com"
      ],
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "info@doniputra.com"
        },
        "ForAllValues:StringEquals": {
          "ses:Recipients": ["doniputrapurbawa@gmail.com"]
        }
      }
    }
  ]
}
