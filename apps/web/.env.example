# Public Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# Leave empty to disable analytics locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Public canonical website origin; set at build time in Coolify.
NEXT_PUBLIC_SITE_URL=https://doniputra.com
# Public HTTPS API origin for uploads and client requests (not the internal API_URL).
NEXT_PUBLIC_API_URL=https://api.doniputra.com
# Server-to-server API URL; may use your private Coolify network hostname.
API_URL=http://localhost:4000
# Optional token from Search Console's HTML-tag verification method (not the whole tag).
GOOGLE_SITE_VERIFICATION=
