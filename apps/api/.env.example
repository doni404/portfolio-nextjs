# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio_db"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# Uploaded project/blog media. Mount this directory as persistent storage in production.
# Leave unset to use <project>/apps/api/storage/uploads (default via process.cwd())
# UPLOAD_DIR=/absolute/path/to/storage/uploads

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=

# ─── Admin Seed ───────────────────────────────────────────────────────────────
# Used only during db:seed — never hardcode passwords
SEED_ADMIN_PASSWORD=changeme123

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Journal automation: OFF by default in the database. Use a dedicated worker token.
# Coolify scheduled tasks run the lightweight API worker; Docker builds stay on GitHub.
# Keep both credentials runtime-only. GitHub can also run the manual fallback.
AUTOMATION_WORKER_TOKEN=
# Connection status is determined by authenticated worker heartbeats, not a flag.
EDITORIAL_API_URL=http://localhost:4000
OPENAI_API_KEY=
# Email: verify your sending domain with Resend before enabling notifications.
RESEND_API_KEY=
EDITORIAL_EMAIL_FROM=
# GA4 Data API: numeric property ID, NOT the G- measurement ID.
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local alternative: absolute path to an ignored service-account JSON, never a public folder.
GOOGLE_APPLICATION_CREDENTIALS=
